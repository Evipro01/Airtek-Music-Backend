PORT=3000

# "production" en Railway/Render: activa `trust proxy`
NODE_ENV=development

# URL(s) del frontend autorizadas por CORS, separadas por comas (sin barra final).
# Ej. producción: FRONTEND_URL=https://airtek-music.vercel.app,http://localhost:5173
# (CORS_ORIGIN sigue funcionando como alias)
FRONTEND_URL=http://localhost:5173

# Opcional: saltos de proxy de confianza. Por defecto 1 en producción y desactivado en local.
# Con el rewrite de Vercel delante de Railway/Render son 2. Sin el valor correcto, la comprobación
# de la red de Airtek vería la IP del proxy y rechazaría a todos.
TRUST_PROXY=

# Rangos de IP de la red de Airtek (CIDR separados por comas). Solo esas conexiones pueden usar la app.
# Ej.: AIRTEK_IP_RANGES=190.120.0.0/16,200.44.32.0/19
# Vacío en local: se aceptan localhost y las redes privadas. Vacío en producción: se rechaza a todos.
AIRTEK_IP_RANGES=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clave del panel de administración (cabecera X-Admin-Key), mínimo 16 caracteres.
# Genera una con: node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
# Sin ella el panel queda desactivado.
ADMIN_API_KEY= l18T2h8D4Q0IiyLZdQhbYXqXafINpLXa

# Opcional: con él Jamendo se consulta vía su API oficial (https://devportal.jamendo.com)
JAMENDO_CLIENT_ID=
